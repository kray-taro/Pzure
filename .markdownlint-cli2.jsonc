{
  // markdownlint-cli2 runner config for the DOCS verification loop (#56, #68).
  // The rule set itself lives in .markdownlint.jsonc; this file only controls
  // which files the full-tree run lints.
  //
  // The legacy module specifications under DOCS/Modules/Module_* and
  // Modul_Master intentionally use many top-level (#) headings as section
  // markers. That triggers MD025 en masse. Rewriting their heading hierarchy
  // would change in-document section anchors, so they are excluded from
  // linting here rather than weakening MD025 for the whole repository.
  // All other DOCS markdown remains fully linted and blocking.
  "ignores": [
    "**/node_modules/**",
    "DOCS/Modules/Module_*",
    "DOCS/Modules/Modul_Master*"
  ]
}
