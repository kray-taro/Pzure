{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "bg": {
      "default": "{slate.50}",
      "surface": "{white}",
      "muted": "{slate.100}",
      "inverse": "{slate.900}"
    },
    "text": {
      "default": "{slate.900}",
      "muted": "{slate.600}",
      "inverse": "{white}"
    },
    "border": {
      "default": "{slate.200}",
      "focus": "{blue.600}",
      "danger": "{red.600}"
    },
    "status": {
      "success": "{green.600}",
      "warning": "{amber.600}",
      "danger": "{red.600}",
      "info": "{blue.600}",
      "neutral": "{slate.500}"
    },
    "clinical": {
      "critical": "{red.700}",
      "warning": "{amber.700}",
      "normal": "{green.700}",
      "sensitive": "{purple.700}"
    },
    "finance": {
      "paid": "{green.600}",
      "unpaid": "{amber.600}",
      "refunded": "{blue.600}",
      "credit": "{indigo.600}"
    },
    "inventory": {
      "available": "{green.600}",
      "low": "{amber.600}",
      "expired": "{red.700}",
      "quarantined": "{purple.700}",
      "recalled": "{red.800}"
    },
    "claims": {
      "draft": "{slate.500}",
      "ready": "{blue.600}",
      "submitted": "{indigo.600}",
      "rejected": "{red.600}",
      "paid": "{green.600}"
    },
    "sync": {
      "online": "{green.600}",
      "offline": "{slate.500}",
      "queued": "{amber.600}",
      "conflict": "{red.600}"
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadow": {
    "card": "0 1px 2px 0 rgba(15, 23, 42, 0.06), 0 1px 3px 0 rgba(15, 23, 42, 0.10)",
    "modal": "0 10px 15px -3px rgba(15, 23, 42, 0.10), 0 4px 6px -4px rgba(15, 23, 42, 0.10)",
    "drawer": "-8px 0 24px -4px rgba(15, 23, 42, 0.15)",
    "focus": "0 0 0 3px rgba(37, 99, 235, 0.45)"
  },
  "font": {
    "family": {
      "sans": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "size": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "24px",
      "posTotal": "40px"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "lineHeight": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.75"
    }
  },
  "breakpoint": {
    "xs": "360px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px",
    "pos": "1024px",
    "kiosk": "768px"
  },
  "z": {
    "base": "0",
    "dropdown": "1000",
    "sticky": "1100",
    "drawer": "1200",
    "modal": "1300",
    "toast": "1400",
    "offlineBanner": "1500"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1)"
    }
  },
  "touch": {
    "targetMin": "48px",
    "posButtonHeight": "64px",
    "posKeypadButton": "64px",
    "productTile": "96px",
    "cartRow": "48px"
  },
  "layout": {
    "sidebarWidth": "264px",
    "sidebarCollapsedWidth": "72px",
    "headerHeight": "56px",
    "posCartWidth": "380px"
  }
}
