{
  // Deterministic markdownlint rule set for the DOCS verification loop
  // (#56, #68). Real structural problems fail CI; the relaxations below are
  // each justified, not blanket suppressions.
  "default": true,
  // MD013 (line length): off. ADRs and wide tables intentionally use long
  // lines; wrapping prose would hurt readability and diff churn.
  "MD013": false,
  // MD024 (duplicate headings): siblings_only. Docs legitimately repeat
  // section headings such as '### Positive Consequences' or '### Deliverables'
  // under different parents; uniqueness is only required among siblings.
  "MD024": { "siblings_only": true },
  // MD033 (inline HTML): off. Occasional inline HTML is allowed in docs.
  "MD033": false,
  // MD041 (first line must be a top-level heading): off. Some docs lead with
  // a status/metadata block before the H1.
  "MD041": false
}
