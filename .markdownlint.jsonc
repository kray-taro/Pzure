{
  // Deterministic markdownlint rule set for the DOCS verification loop (#56).
  // Real structural problems fail CI; only the noisy line-length rule is
  // relaxed so existing long-form prose and wide tables are not punished.
  "default": true,
  // MD004 (unordered list marker): fixed to dash. The corpus standard is '-';
  // a fixed style (rather than 'consistent') keeps every file uniform.
  "MD004": { "style": "dash" },
  // MD013 (line length): off. Our ADRs and tables intentionally use long lines.
  "MD013": false,
  // MD024 (duplicate headings): siblings_only. Docs legitimately repeat
  // section headings such as '### Positive Consequences' or '### Deliverables'
  // under different parents; uniqueness is only required among siblings.
  "MD024": { "siblings_only": true },
  // MD033 (inline HTML): off. Occasional inline HTML is allowed in docs.
  "MD033": false,
  // MD041 (first line must be a top-level heading): off. Some docs lead with
  // a status/metadata block before the H1.
  "MD041": false
}
