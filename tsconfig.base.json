{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@pzure/contracts": ["packages/contracts/src/index.ts"],
      "@pzure/domain": ["packages/domain/src/index.ts"],
      "@pzure/application": ["packages/application/src/index.ts"],
      "@pzure/infrastructure": ["packages/infrastructure/src/index.ts"]
    }
  }
}
