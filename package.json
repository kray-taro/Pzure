{
  "name": "@pzure/root",
  "version": "0.0.0",
  "private": true,
  "description": "Pzure monorepo root. Develop integration line. main untouched until release gate.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p packages/design-tokens/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json",
    "test": "vitest run --coverage",
    "storybook": "npm run storybook -w @pzure/ui",
    "build-storybook": "npm run build-storybook -w @pzure/ui",
    "guard:branch": "bash scripts/check-branch-name.sh",
    "guard:hex": "bash scripts/check-no-raw-hex.sh",
    "guard:secrets": "bash scripts/check-no-secrets.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@storybook/addon-a11y": "^8.2.9",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/react": "^8.2.9",
    "@storybook/react-vite": "^8.2.9",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.2.9",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
