# Copy to .env (gitignored). No real secrets in the repo (COMPLIANCE.md).
NODE_ENV=development

# SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=pzure
DB_USER=pzure_app
DB_PASSWORD=

# Redis / BullMQ (ADR-005, D-001)
REDIS_URL=redis://localhost:6379

# Keycloak (ADR-002, D-005)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=pzure-api
OIDC_CLIENT_SECRET=

# Encryption KEK reference (ADR-003; KMS binding deferred to B-006)
KEK_PROVIDER=local-dev
KEK_KEY_REF=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
